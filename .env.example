MONGODB_URI=your_mongodb_connection_string_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
HF_API_KEY=your_huggingface_read_token_here

# Auth
JWT_SECRET=replace_with_a_long_random_string
# Bootstrap admin account, created automatically on first startup if no admin exists yet
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_immediately

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to local dev origins (localhost:5173/3000) if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo accounts (OFF by default). Set SEED_DEMO_USERS=true to have the backend
# create a demo teacher + demo student account on startup, so a deployed demo
# can be logged into without an admin creating real accounts first.
# Leave this off for real deployments with real students.
SEED_DEMO_USERS=false
DEMO_TEACHER_USERNAME=demo_teacher
DEMO_TEACHER_PASSWORD=demo1234
DEMO_STUDENT_USERNAME=demo_student
DEMO_STUDENT_PASSWORD=demo1234
DEMO_STUDENT_ROLL_NO=DEMO001
